\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Proof-matched continuous fluid reference at $z=20$ and 400-ppm initial spread. Occupancy bands cover all six channels. Fuzzy remains above zero, while the unprotected PI trajectory crosses the lower boundary. Dotted bounds come from the separate all-time certificate. Applied physical frequencies stay positive; signed corrections may be negative.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:safety_reference_z20}{{1}{8}{Proof-matched continuous fluid reference at $z=20$ and 400-ppm initial spread. Occupancy bands cover all six channels. Fuzzy remains above zero, while the unprotected PI trajectory crosses the lower boundary. Dotted bounds come from the separate all-time certificate. Applied physical frequencies stay positive; signed corrections may be negative}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Compatible-target--mismatch slices at fixed capacity and gains. Green denotes the joint coarse sufficient domain. Blue columns extend to finite-horizon normal observations at sampled spreads only; markers give observed excursion boundaries. Purple denotes the sharper all-time slice at $s=1$. The dotted line is PI's directional threshold at $z=20$. Central targets are omitted for readability. No untested interpolation or delayed-Callisto safety boundary is asserted.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:safety_domain}{{2}{9}{Compatible-target--mismatch slices at fixed capacity and gains. Green denotes the joint coarse sufficient domain. Blue columns extend to finite-horizon normal observations at sampled spreads only; markers give observed excursion boundaries. Purple denotes the sharper all-time slice at $s=1$. The dotted line is PI's directional threshold at $z=20$. Central targets are omitted for readability. No untested interpolation or delayed-Callisto safety boundary is asserted}{figure.caption.10}{}}
